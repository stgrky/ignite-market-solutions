# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Create a GA4 property at analytics.google.com, then paste the ID here.
# Analytics is a no-op when this is unset.
NEXT_PUBLIC_GA_ID=

# Resend API key — powers the auto-confirmation email sent to anyone who
# submits the contact form. Create an account at resend.com and verify a
# SUBDOMAIN (e.g. mail.ignitecreativeco.world) so Google Workspace mail on the
# apex domain is unaffected. See ims-ops/RUNBOOK.md §7b.
# The confirmation email is a no-op when this (or CONTACT_FROM_EMAIL) is unset.
RESEND_API_KEY=

# Verified sender for that confirmation email.
# Format: "Ignite Creative Co <hello@mail.ignitecreativeco.world>"
CONTACT_FROM_EMAIL=
